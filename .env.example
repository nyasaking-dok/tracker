# Server
PORT=3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://plaspy:plaspy@localhost:5432/plaspy?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Seed credentials (master account)
MASTER_USERNAME=master
MASTER_API_KEY=master-api-key-123
